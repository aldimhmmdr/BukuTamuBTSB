@page
@model PenggunaModel

@{
    Layout = "_AdminLayout";

    ViewData["Title"] = "Pengguna";
    ViewData["PageTitle"] = "Pengguna";
    ViewData["PageDescription"] =
        "Kelola akun pengguna sistem Buku Tamu Digital";
}


<section class="pengguna-page">


    <!-- =====================================================
         NOTIFICATION / ALERT
    ====================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="pengguna-alert pengguna-alert-success">

            <svg viewBox="0 0 24 24">
                <path d="M20 6 9 17l-5-5" />
            </svg>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="pengguna-alert pengguna-alert-error">

            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 8v5" />
                <path d="M12 16h.01" />
            </svg>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }


    <!-- =====================================================
         MAIN CARD
    ====================================================== -->

    <div class="pengguna-card">


        <!-- =================================================
             CARD HEADER
        ================================================== -->

        <div class="pengguna-card-header">

            <div>

                <h2>
                    Daftar Pengguna
                </h2>

                <p>
                    Kelola akun yang dapat mengakses sistem
                </p>

            </div>


            <button type="button"
                    class="pengguna-add-button"
                    onclick="openTambahModal()">

                <svg viewBox="0 0 24 24">
                    <path d="M12 5v14" />
                    <path d="M5 12h14" />
                </svg>

                <span>
                    Tambah Pengguna
                </span>

            </button>

        </div>


        <!-- =================================================
             TABLE
        ================================================== -->

        <div class="pengguna-table-wrapper">

            @if (Model.DaftarPengguna.Count == 0)
            {
                <div class="pengguna-empty">

                    <div class="pengguna-empty-icon">

                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="3" />
                            <path d="M5 20c.8-3.5 3.1-5 7-5s6.2 1.5 7 5" />
                        </svg>

                    </div>

                    <h3>
                        Belum ada pengguna
                    </h3>

                    <p>
                        Tambahkan pengguna untuk mulai mengelola akses sistem.
                    </p>

                </div>
            }
            else
            {

                <table class="pengguna-table">

                    <thead>

                        <tr>

                            <th class="col-no">
                                No
                            </th>

                            <th>
                                Nama
                            </th>

                            <th>
                                Username
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Dibuat
                            </th>

                            <th class="col-action">
                                Aksi
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int no = 1;
                        }


                        @foreach (var user in Model.DaftarPengguna)
                        {

                            <tr>


                                <!-- NO -->

                                <td class="col-no">
                                    @no
                                </td>


                                <!-- NAMA -->

                                <td>

                                    <div class="user-name-cell">

                                        <div class="user-mini-avatar">

                                            <svg viewBox="0 0 24 24">

                                                <circle cx="12"
                                                        cy="8"
                                                        r="3" />

                                                <path d="M5 20c.8-3.5 3.1-5 7-5s6.2 1.5 7 5" />

                                            </svg>

                                        </div>

                                        <strong>
                                            @user.Nama
                                        </strong>

                                    </div>

                                </td>


                                <!-- USERNAME -->

                                <td>

                                    <span class="username-text">
                                        @user.Username
                                    </span>

                                </td>


                                <!-- EMAIL -->

                                <td>
                                    <span class="username-text">
                                        @(string.IsNullOrWhiteSpace(user.Email) ? "Belum diisi" : user.Email)
                                    </span>
                                </td>


                                <!-- ROLE -->

                                <td>

                                    @if (user.Role == "Admin")
                                    {
                                        <span class="pengguna-badge pengguna-badge-admin">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pengguna-badge pengguna-badge-petugas">
                                            Petugas
                                        </span>
                                    }

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (user.Status)
                                    {
                                        <span class="pengguna-badge pengguna-badge-active">

                                            <span class="status-dot"></span>

                                            Aktif

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pengguna-badge pengguna-badge-inactive">

                                            <span class="status-dot"></span>

                                            Nonaktif

                                        </span>
                                    }

                                </td>


                                <!-- CREATED -->

                                <td>

                                    <span class="created-text">

                                        @user.CreatedAt.ToString("dd/MM/yyyy")

                                    </span>

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <div class="pengguna-actions">


                                        <!-- EDIT -->

                                        <button type="button"
                                                class="pengguna-action edit"
                                                title="Edit pengguna"
                                                onclick="openEditModal(
                                            '@user.Id',
                                            '@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(user.Nama))',
                                            '@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(user.Username))',
                                            '@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(user.Email ?? ""))',
                                            '@user.Role')">

                                            <svg viewBox="0 0 24 24">

                                                <path d="M4 20h4L19 9l-4-4L4 16v4z" />

                                                <path d="m13.5 6.5 4 4" />

                                            </svg>

                                            <span>
                                                Edit
                                            </span>

                                        </button>


                                        <!-- TOGGLE STATUS -->

                                        <form method="post"
                                              asp-page-handler="ToggleStatus"
                                              class="inline-form">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="pengguna-action status"
                                                    title="@(user.Status ? "Nonaktifkan pengguna" : "Aktifkan pengguna")">

                                                @if (user.Status)
                                                {
                                                    <svg viewBox="0 0 24 24">
                                                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                                                        <path d="M10 21h4" />
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg viewBox="0 0 24 24">
                                                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                                                        <path d="M10 21h4" />
                                                        <path d="M4 4l16 16" />
                                                    </svg>
                                                }

                                                <span>
                                                    @(user.Status ? "Nonaktifkan" : "Aktifkan")
                                                </span>

                                            </button>

                                        </form>


                                        <!-- HAPUS -->

                                        <form method="post"
                                              asp-page-handler="Hapus"
                                              class="inline-form"
                                              onsubmit="return confirm('Apakah Anda yakin ingin menghapus pengguna ini?');">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="pengguna-action delete"
                                                    title="Hapus pengguna">

                                                <svg viewBox="0 0 24 24">

                                                    <path d="M4 7h16" />

                                                    <path d="M10 11v6" />

                                                    <path d="M14 11v6" />

                                                    <path d="M6 7l1 13h10l1-13" />

                                                    <path d="M9 7V4h6v3" />

                                                </svg>

                                                <span>
                                                    Hapus
                                                </span>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                            no++;
                        }

                    </tbody>

                </table>

            }

        </div>

    </div>

</section>


<!-- =========================================================
     MODAL TAMBAH PENGGUNA
========================================================= -->

<div id="tambahModal"
     class="pengguna-modal">

    <div class="pengguna-modal-box">


        <!-- HEADER -->

        <div class="pengguna-modal-header">

            <div>

                <h3>
                    Tambah Pengguna
                </h3>

                <p>
                    Buat akun baru untuk pengguna sistem.
                </p>

            </div>


            <button type="button"
                    class="pengguna-modal-close"
                    onclick="closeTambahModal()">

                <svg viewBox="0 0 24 24">

                    <path d="M6 6l12 12" />

                    <path d="M18 6 6 18" />

                </svg>

            </button>

        </div>


        <!-- FORM -->

        <form method="post"
              asp-page-handler="Tambah">


            <div class="pengguna-modal-body">


                <div class="pengguna-form-group">

                    <label>
                        Nama Lengkap
                    </label>

                    <input type="text"
                           name="Input.Nama"
                           class="pengguna-form-control"
                           placeholder="Masukkan nama lengkap"
                           autocomplete="name"
                           required />

                </div>


                <div class="pengguna-form-group">

                    <label>
                        Username
                    </label>

                    <input type="text"
                           name="Input.Username"
                           class="pengguna-form-control"
                           placeholder="Masukkan username"
                           autocomplete="username"
                           required />

                </div>


                <div class="pengguna-form-group">

                    <label for="tambahEmail">
                        Email
                    </label>

                    <input type="email"
                           id="tambahEmail"
                           name="Input.Email"
                           class="pengguna-form-control"
                           placeholder="nama@contoh.com"
                           autocomplete="email"
                           required />

                </div>


                <div class="pengguna-form-group">

                    <label>
                        Password
                    </label>

                    <input type="password"
                           name="Input.Password"
                           class="pengguna-form-control"
                           placeholder="Masukkan password"
                           autocomplete="new-password"
                           required />

                </div>


                <div class="pengguna-form-group">

                    <label>
                        Role
                    </label>

                    <select name="Input.Role"
                            class="pengguna-form-control">

                        <option value="Petugas">
                            Petugas
                        </option>

                        <option value="Admin">
                            Admin
                        </option>

                    </select>

                </div>

            </div>


            <div class="pengguna-modal-footer">

                <button type="button"
                        class="pengguna-secondary-button"
                        onclick="closeTambahModal()">

                    Batal

                </button>


                <button type="submit"
                        class="pengguna-primary-button">

                    Simpan Pengguna

                </button>

            </div>

        </form>

    </div>

</div>


<!-- =========================================================
     MODAL EDIT PENGGUNA
========================================================= -->

<div id="editModal"
     class="pengguna-modal">

    <div class="pengguna-modal-box">


        <!-- HEADER -->

        <div class="pengguna-modal-header">

            <div>

                <h3>
                    Edit Pengguna
                </h3>

                <p>
                    Perbarui informasi akun pengguna.
                </p>

            </div>


            <button type="button"
                    class="pengguna-modal-close"
                    onclick="closeEditModal()">

                <svg viewBox="0 0 24 24">

                    <path d="M6 6l12 12" />

                    <path d="M18 6 6 18" />

                </svg>

            </button>

        </div>


        <!-- FORM -->

        <form method="post"
              asp-page-handler="Edit">


            <input type="hidden"
                   id="editId"
                   name="EditId" />


            <div class="pengguna-modal-body">


                <div class="pengguna-form-group">

                    <label>
                        Nama Lengkap
                    </label>

                    <input type="text"
                           id="editNama"
                           name="Input.Nama"
                           class="pengguna-form-control"
                           required />

                </div>


                <div class="pengguna-form-group">

                    <label>
                        Username
                    </label>

                    <input type="text"
                           id="editUsername"
                           name="Input.Username"
                           class="pengguna-form-control"
                           autocomplete="username"
                           required />

                </div>


                <div class="pengguna-form-group">

                    <label for="editEmail">
                        Email
                    </label>

                    <input type="email"
                           id="editEmail"
                           name="Input.Email"
                           class="pengguna-form-control"
                           placeholder="nama@contoh.com"
                           autocomplete="email"
                           required />

                </div>


                <div class="pengguna-form-group">

                    <label>
                        Password Baru
                    </label>

                    <input type="password"
                           name="PasswordBaru"
                           class="pengguna-form-control"
                           placeholder="Kosongkan jika tidak ingin mengubah password"
                           autocomplete="new-password" />

                </div>


                <div class="pengguna-form-group">

                    <label>
                        Role
                    </label>

                    <select id="editRole"
                            name="Input.Role"
                            class="pengguna-form-control">

                        <option value="Petugas">
                            Petugas
                        </option>

                        <option value="Admin">
                            Admin
                        </option>

                    </select>

                </div>

            </div>


            <div class="pengguna-modal-footer">

                <button type="button"
                        class="pengguna-secondary-button"
                        onclick="closeEditModal()">

                    Batal

                </button>


                <button type="submit"
                        class="pengguna-primary-button">

                    Simpan Perubahan

                </button>

            </div>

        </form>

    </div>

</div>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

    function openTambahModal() {

        document
            .getElementById("tambahModal")
            .classList.add("show");

    }


    function closeTambahModal() {

        document
            .getElementById("tambahModal")
            .classList.remove("show");

    }


    function openEditModal(
        id,
        nama,
        username,
        email,
        role
    ) {

        document
            .getElementById("editId")
            .value = id;


        document
            .getElementById("editNama")
            .value = nama;


        document
            .getElementById("editUsername")
            .value = username;


        document
            .getElementById("editEmail")
            .value = email;


        document
            .getElementById("editRole")
            .value = role;


        document
            .getElementById("editModal")
            .classList.add("show");

    }


    function closeEditModal() {

        document
            .getElementById("editModal")
            .classList.remove("show");

    }


    document.addEventListener(
        "keydown",
        function(event) {

            if (event.key === "Escape") {

                closeTambahModal();

                closeEditModal();

            }

        }
    );


    window.addEventListener(
        "click",
        function(event) {

            const tambahModal =
                document.getElementById("tambahModal");

            const editModal =
                document.getElementById("editModal");


            if (event.target === tambahModal) {

                closeTambahModal();

            }


            if (event.target === editModal) {

                closeEditModal();

            }

        }
    );

</script>


<style>

    /* =====================================================
           PAGE
        ====================================================== */

    .pengguna-page {
        width: 100%;
    }


    /* =====================================================
           ALERT
        ====================================================== */

    .pengguna-alert {
        min-height: 42px;
        margin-bottom: 16px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        gap: 9px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 500;
    }


        .pengguna-alert svg {
            width: 17px;
            height: 17px;
            flex-shrink: 0;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8px;
            stroke-linecap: round;
            stroke-linejoin: round;
        }


    .pengguna-alert-success {
        color: #18794e;
        background: #edf9f2;
        border: 1px solid #cdebd9;
    }


    .pengguna-alert-error {
        color: #c0392b;
        background: #fff1ef;
        border: 1px solid #f2d0cc;
    }


    /* =====================================================
           MAIN CARD
        ====================================================== */

    .pengguna-card {
        width: 100%;
        background: #ffffff;
        border: 1px solid #dce5ef;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(20, 50, 80, .035);
    }


    /* =====================================================
           CARD HEADER
        ====================================================== */

    .pengguna-card-header {
        min-height: 74px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid #e7edf3;
    }


        .pengguna-card-header h2 {
            margin: 0;
            color: #123f73;
            font-size: 15px;
            font-weight: 700;
        }


        .pengguna-card-header p {
            margin: 4px 0 0;
            color: #8291a3;
            font-size: 10px;
        }


    /* =====================================================
           ADD BUTTON
        ====================================================== */

    .pengguna-add-button {
        height: 34px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: none;
        border-radius: 6px;
        background: #1681d4;
        color: #ffffff;
        font-family: inherit;
        font-size: 10px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 2px 5px rgba(22,129,212,.15);
        transition: background .2s ease, transform .2s ease;
    }


        .pengguna-add-button:hover {
            background: #126fb9;
            transform: translateY(-1px);
        }


        .pengguna-add-button svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
        }


    /* =====================================================
           TABLE
        ====================================================== */

    .pengguna-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }


    .pengguna-table {
        width: 100%;
        min-width: 760px;
        border-collapse: collapse;
        table-layout: auto;
    }


        /* =====================================================
           TABLE HEADER
        ====================================================== */

        .pengguna-table thead th {
            height: 42px;
            padding: 0 10px;
            background: #f7faff;
            border-bottom: 1px solid #e2e9f1;
            color: #294c73;
            font-size: 9px;
            font-weight: 700;
            text-align: left;
            white-space: nowrap;
        }


            .pengguna-table thead th.col-no {
                width: 45px;
                text-align: center;
            }


            .pengguna-table thead th.col-action {
                width: 145px;
                text-align: center;
            }


        /* =====================================================
           TABLE BODY
        ====================================================== */

        .pengguna-table tbody tr {
            height: 51px;
            border-bottom: 1px solid #edf1f5;
            transition: background .15s ease;
        }


            .pengguna-table tbody tr:last-child {
                border-bottom: none;
            }


            .pengguna-table tbody tr:hover {
                background: #fafcff;
            }


        .pengguna-table tbody td {
            padding: 7px 10px;
            color: #52657a;
            font-size: 10px;
            vertical-align: middle;
            white-space: nowrap;
        }


            .pengguna-table tbody td.col-no {
                text-align: center;
                color: #7f8ea0;
            }


            .pengguna-table tbody td strong {
                color: #294b72;
                font-size: 10px;
                font-weight: 600;
            }


    /* =====================================================
           USER NAME
        ====================================================== */

    .user-name-cell {
        display: flex;
        align-items: center;
        gap: 8px;
    }


    .user-mini-avatar {
        width: 27px;
        height: 27px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: #edf3fc;
        color: #40377e;
    }


        .user-mini-avatar svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8px;
            stroke-linecap: round;
            stroke-linejoin: round;
        }


    .username-text {
        color: #5f7083;
        font-size: 10px;
    }


    .created-text {
        color: #718297;
        font-size: 9px;
    }


    /* =====================================================
           BADGE
        ====================================================== */

    .pengguna-badge {
        min-height: 22px;
        padding: 0 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        font-size: 8px;
        font-weight: 700;
    }


    .pengguna-badge-admin {
        background: #e6f1ff;
        color: #1774c4;
    }


    .pengguna-badge-petugas {
        background: #edf3ff;
        color: #4a63a0;
    }


    .pengguna-badge-active {
        background: #e8f8ef;
        color: #168451;
    }


    .pengguna-badge-inactive {
        background: #ffeded;
        color: #dc4b4b;
    }


    .status-dot {
        width: 5px;
        height: 5px;
        margin-right: 5px;
        border-radius: 50%;
        background: currentColor;
    }


    /* =====================================================
           ACTIONS
        ====================================================== */

    .pengguna-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
    }


    .inline-form {
        display: inline-flex;
        margin: 0;
        padding: 0;
    }


    .pengguna-action {
        min-height: 25px;
        padding: 0 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border: 1px solid #dce5ef;
        border-radius: 5px;
        background: #ffffff;
        color: #3673a8;
        font-family: inherit;
        font-size: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: background .2s ease, border-color .2s ease, color .2s ease;
    }


        .pengguna-action svg {
            width: 11px;
            height: 11px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8px;
            stroke-linecap: round;
            stroke-linejoin: round;
        }


        .pengguna-action.edit:hover {
            background: #eef6ff;
            border-color: #bcd9f4;
            color: #126db2;
        }


        .pengguna-action.status:hover {
            background: #fff8e8;
            border-color: #f1dcad;
            color: #a87918;
        }


        .pengguna-action.delete {
            color: #df5555;
            border-color: #f0d0d0;
        }


            .pengguna-action.delete:hover {
                background: #fff0f0;
                border-color: #eab5b5;
                color: #c83f3f;
            }


    /* =====================================================
           EMPTY
        ====================================================== */

    .pengguna-empty {
        min-height: 260px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }


    .pengguna-empty-icon {
        width: 54px;
        height: 54px;
